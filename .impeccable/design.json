    {
      "name": "Node operation panel",
      "kind": "custom",
      "refersTo": "node-operation",
      "description": "Unknown-state example: live facts remain em dashes until a successful observation.",
      "html": "<section class=\"ds-node\"><div class=\"ds-node-heading\"><div class=\"ds-node-mark\"><svg width=\"30\" height=\"30\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"2\"/><rect x=\"9\" y=\"9\" width=\"6\" height=\"6\"/><path d=\"M9 2v2m6-2v2M9 20v2m6-2v2M2 9h2m-2 6h2m16-6h2m-2 6h2\"/></svg></div><div><h2>Checking node controls</h2><p>Reading the local application status.</p></div><span class=\"ds-node-role\">Verifying full node</span></div><div class=\"ds-node-facts\"><div><span>Accepted height</span><strong>—</strong></div><div><span>Connected peers</span><strong>—</strong></div><div><span>Transport</span><strong>—</strong></div></div></section>",
      "css": ".ds-node{border:1px solid var(--borders);border-radius:10px;padding:28px;background:rgba(16,26,39,.42);color:var(--ice-white);font-family:var(--font-ui)}.ds-node-heading{display:flex;align-items:center;gap:18px;margin-bottom:28px}.ds-node-heading h2{margin:0;font-size:23px;font-weight:550;line-height:1.25;letter-spacing:-.015em}.ds-node-heading p{margin:5px 0 0;font-size:13px;color:var(--secondary-text);line-height:1.5}.ds-node-mark{width:58px;height:58px;border:1px solid var(--steel-blue);border-radius:10px;display:grid;place-items:center;color:var(--secondary-text);flex-shrink:0}.ds-node-role{margin-left:auto;color:var(--ice-white);font-size:11px;border:1px solid var(--borders);border-radius:4px;padding:5px 9px}.ds-node-facts{display:flex;flex-wrap:wrap;gap:40px;padding:0 0 28px}.ds-node-facts>div{display:grid;gap:7px}.ds-node-facts span{color:var(--secondary-text);font-size:12px}.ds-node-facts strong{font-size:23px;font-weight:450;font-variant-numeric:tabular-nums}@media(max-width:760px){.ds-node{padding:20px}.ds-node-heading{flex-wrap:wrap;gap:12px}.ds-node-heading h2{font-size:20px}.ds-node-mark{width:45px;height:45px}.ds-node-role{margin-left:0}.ds-node-facts{gap:22px}}"
