    {
      "name": "Network panel",
      "kind": "card",
      "refersTo": "network-panel",
      "description": "Quiet network facts; em dashes represent data not yet read.",
      "html": "<section class=\"ds-network\"><div class=\"ds-panel-heading\"><h2>Connected network</h2><span class=\"ds-connection-dot\"></span></div><div class=\"ds-network-name\">ORVEXA <span>Local devnet</span></div><p class=\"ds-node-origin\">Waiting for node</p><dl class=\"ds-network-facts\"><div><dt>Block height</dt><dd>—</dd></div><div><dt>Pending transfers</dt><dd>—</dd></div><div><dt>Burned fees</dt><dd>—</dd></div></dl></section>",
      "css": ".ds-network{border:1px solid var(--borders);border-radius:10px;padding:25px 25px 18px;background:rgba(16,26,39,.42);color:var(--ice-white);font-family:var(--font-ui)}.ds-panel-heading{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:23px}.ds-panel-heading h2{margin:0;font-size:14px;font-weight:550;line-height:1.25;letter-spacing:-.015em}.ds-connection-dot{height:6px;width:6px;background:#526071;border-radius:50%}.ds-network-name{font-size:18px;font-weight:500;letter-spacing:-.02em}.ds-network-name>span{margin-left:7px;font-size:10px;padding:3px 6px;border:1px solid #34485f;border-radius:4px;color:#b8cadf;font-weight:400;vertical-align:2px;letter-spacing:0}.ds-node-origin{font-size:10px;color:var(--secondary-text);margin:8px 0 22px}.ds-network-facts{display:grid;gap:13px;margin:0 0 20px}.ds-network-facts>div{display:flex;justify-content:space-between;gap:10px}.ds-network-facts dt{font-size:11px;color:var(--secondary-text)}.ds-network-facts dd{margin:0;font-size:11px;color:#d2e1f2;font-variant-numeric:tabular-nums}"
